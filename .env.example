# Copy this file to .env for local development and fill in your own values.
# On Render, set these as Environment Variables in the service dashboard instead
# of using a .env file (Render does not read .env files automatically).

# MongoDB Atlas connection string. Get this from Atlas: Database > Connect >
# Drivers, then paste it here and replace <password> with your actual password.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/ftfr_sla?retryWrites=true&w=majority

# Local port (Render sets PORT automatically, this is only used when you run
# the server on your own machine).
PORT=3000
